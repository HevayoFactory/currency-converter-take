{
  "name": "currency-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "currency-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F1.6",
    "F2.1",
    "F2.2",
    "F2.3"
  ],
  "description": "The single-page app where a signed-in user converts amounts with live rates (instant result, swap, rate and fetch time, rates-unavailable notice) and reviews or deletes entries in their own conversion log. It signs users in through Thunder SSO and calls only currency-api; it holds no secrets and does not fetch rates itself.",
  "dependencies": [
    {
      "kind": "component",
      "name": "currency-api",
      "wiring": {
        "endpoint": {
          "component": "currency-converter-take-currency-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "CURRENCY_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "currency-converte-91b4c474",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
